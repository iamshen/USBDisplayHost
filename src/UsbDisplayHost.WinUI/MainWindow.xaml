<Window
    x:Class="UsbDisplayHost.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:UsbDisplayHost.WinUI.Views"
    Title="USB Display Beta">
    <Grid x:Name="WorkspaceRoot" Background="{ThemeResource WorkspaceCanvasBrush}"
          RowDefinitions="36,68,*,Auto" RequestedTheme="Dark">
        <Border x:Name="TitleDragRegion" />
        <Border
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,4,0,0"
            Padding="6,2"
            Width="496"
            Height="48"
            Background="{ThemeResource WorkspaceNavigationBrush}"
            CornerRadius="24">
            <StackPanel Orientation="Horizontal" Spacing="7">
                <Border Width="38" Height="38" VerticalAlignment="Center" CornerRadius="19"
                        Background="{ThemeResource WorkspaceInsetBrush}">
                    <FontIcon Glyph="&#xE7F4;" FontSize="20" AutomationProperties.AccessibilityView="Raw" />
                </Border>
                <SelectorBar x:Name="WorkspaceNavigation" Padding="2,4" VerticalAlignment="Center"
                             AutomationProperties.Name="页面导航">
                    <SelectorBarItem Tag="Devices" Text="设备" Style="{StaticResource WorkspaceNavigationItemStyle}" />
                    <SelectorBarItem Tag="Themes" Text="主题" Style="{StaticResource WorkspaceNavigationItemStyle}" />
                    <SelectorBarItem Tag="DeviceSettings" Text="设备设置" Width="102" Style="{StaticResource WorkspaceNavigationItemStyle}" />
                    <SelectorBarItem Tag="Diagnostics" Text="诊断" Style="{StaticResource WorkspaceNavigationItemStyle}" />
                    <SelectorBarItem Tag="AppSettings" Text="应用设置" Width="102" Style="{StaticResource WorkspaceNavigationItemStyle}" />
                </SelectorBar>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <views:DevicesPage x:Name="DevicesView" />
            <views:ThemesPage x:Name="ThemesView" Visibility="Collapsed" />
            <views:DeviceSettingsPage x:Name="DeviceSettingsView" Visibility="Collapsed" />
            <views:DiagnosticsPage x:Name="DiagnosticsView" Visibility="Collapsed" />
            <views:ApplicationSettingsPage x:Name="AppSettingsView" Visibility="Collapsed" />
        </Grid>

        <InfoBar x:Name="WorkspaceNotice"
                 Grid.Row="3"
                 IsOpen="False"
                 Visibility="Collapsed"
                 Closed="OnNoticeClosed"
                 Margin="32,0,32,16"
                 AutomationProperties.Name="操作反馈" />
    </Grid>
</Window>
