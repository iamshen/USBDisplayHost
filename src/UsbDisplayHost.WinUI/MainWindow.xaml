<Window
    x:Class="UsbDisplayHost.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="USB Display">
    <Grid Background="{ThemeResource WorkspaceCanvasBrush}" RowDefinitions="Auto,*">
        <Border
            HorizontalAlignment="Center"
            Margin="16,20,16,0"
            Padding="4"
            Background="{ThemeResource WorkspaceNavigationBrush}"
            BorderBrush="{ThemeResource WorkspaceDividerBrush}"
            BorderThickness="1"
            CornerRadius="22">
            <SelectorBar x:Name="WorkspaceNavigation" AutomationProperties.Name="页面导航">
                <SelectorBarItem x:Name="DevicesItem" Text="设备" Style="{StaticResource WorkspaceNavigationItemStyle}">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xE7F4;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
                <SelectorBarItem x:Name="DiagnosticsItem" Text="诊断" Style="{StaticResource WorkspaceNavigationItemStyle}">
                    <SelectorBarItem.Icon>
                        <SymbolIcon Symbol="ReportHacked" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
            </SelectorBar>
        </Border>

        <ScrollViewer
            x:Name="DevicesView"
            Grid.Row="1"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch">
            <Grid Padding="24,28,24,52">
                <StackPanel MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                    <Border
                        Width="76"
                        Height="76"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,12"
                        Background="{ThemeResource WorkspaceNavigationBrush}"
                        BorderBrush="{ThemeResource WorkspaceDividerBrush}"
                        BorderThickness="1"
                        CornerRadius="24">
                        <FontIcon
                            Glyph="&#xE7F4;"
                            FontSize="36"
                            Foreground="{ThemeResource WorkspaceTextPrimaryBrush}"
                            AutomationProperties.AccessibilityView="Raw" />
                    </Border>
                    <TextBlock
                        Text="未连接设备"
                        Style="{StaticResource WorkspaceStateHeadingStyle}"
                        TextAlignment="Center"
                        AutomationProperties.HeadingLevel="Level1" />
                    <TextBlock
                        Text="当前以无设备模式运行。"
                        Style="{StaticResource WorkspaceSupportingTextStyle}"
                        TextAlignment="Center" />
                    <Button
                        Content="查看诊断"
                        Margin="0,12,0,0"
                        HorizontalAlignment="Center"
                        MinHeight="36"
                        Click="OnOpenDiagnostics" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <ScrollViewer
            x:Name="DiagnosticsView"
            Grid.Row="1"
            HorizontalContentAlignment="Stretch"
            Visibility="Collapsed">
            <StackPanel MaxWidth="820" Margin="36,48,36,32" Spacing="24">
                <TextBlock
                    Text="诊断"
                    Style="{StaticResource WorkspaceStateHeadingStyle}"
                    AutomationProperties.HeadingLevel="Level1" />
                <StackPanel Spacing="12">
                    <TextBlock
                        Text="启动记录"
                        Style="{StaticResource WorkspaceSectionHeadingStyle}"
                        AutomationProperties.HeadingLevel="Level2" />
                    <Border Style="{StaticResource WorkspacePanelStyle}">
                        <TextBlock x:Name="StartupEntries" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                    </Border>
                    <TextBlock
                        x:Name="StartupLogLocation"
                        Style="{StaticResource WorkspaceSupportingTextStyle}"
                        IsTextSelectionEnabled="True"
                        AutomationProperties.Name="启动日志文件" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
