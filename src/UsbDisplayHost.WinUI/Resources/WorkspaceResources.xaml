<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="WorkspaceCanvasBrush" Color="#171A22" />
            <SolidColorBrush x:Key="WorkspaceNavigationBrush" Color="#212531" />
            <SolidColorBrush x:Key="WorkspaceDividerBrush" Color="#383E4D" />
            <SolidColorBrush x:Key="WorkspaceTextPrimaryBrush" Color="#F2F4F8" />
            <SolidColorBrush x:Key="WorkspaceTextSecondaryBrush" Color="#B3BAC8" />
            <SolidColorBrush x:Key="SelectorBarItemBackgroundSelected" Color="#363E52" />
            <SolidColorBrush x:Key="SelectorBarItemBackgroundPointerOver" Color="#303748" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="WorkspaceCanvasBrush" Color="#F6F7FA" />
            <SolidColorBrush x:Key="WorkspaceNavigationBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="WorkspaceDividerBrush" Color="#D1D6E0" />
            <SolidColorBrush x:Key="WorkspaceTextPrimaryBrush" Color="#202633" />
            <SolidColorBrush x:Key="WorkspaceTextSecondaryBrush" Color="#4D576B" />
            <SolidColorBrush x:Key="SelectorBarItemBackgroundSelected" Color="#DDE5F3" />
            <SolidColorBrush x:Key="SelectorBarItemBackgroundPointerOver" Color="#EDF1F8" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="WorkspaceCanvasBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="WorkspaceNavigationBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="WorkspaceDividerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="WorkspaceTextPrimaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="WorkspaceTextSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SelectorBarItemBackgroundSelected" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="SelectorBarItemForegroundSelected" Color="{ThemeResource SystemColorHighlightTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
    <Style x:Key="WorkspaceNavigationItemStyle" TargetType="SelectorBarItem">
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="16,9" />
    </Style>
    <Style x:Key="WorkspaceStateHeadingStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource WorkspaceTextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="WorkspaceSectionHeadingStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource WorkspaceTextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="WorkspaceSupportingTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{ThemeResource WorkspaceTextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="WorkspacePanelStyle" TargetType="Border">
        <Setter Property="Padding" Value="16" />
        <Setter Property="Background" Value="{ThemeResource WorkspaceNavigationBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource WorkspaceDividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>
</ResourceDictionary>
