<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <Version>0.2.0-beta.5</Version>
        <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
        <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
        <Platforms>x64</Platforms>
        <PlatformTarget>x64</PlatformTarget>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <UseWinUI>true</UseWinUI>
        <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
        <DesktopSource>../UsbDisplayHost.Desktop</DesktopSource>
        <!-- 当前共用的 WPF ViewModel 使用字段生成属性，WinUI 采用非 AOT 部署。 -->
        <NoWarn Condition="'$(PublishAot)' != 'true'">$(NoWarn);MVVMTK0045</NoWarn>
        <WindowsPackageType>None</WindowsPackageType>
        <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
        <SelfContained>true</SelfContained>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>../UsbDisplayHost.Desktop/Assets/Branding/app.ico</ApplicationIcon>
    </PropertyGroup>
    <ItemGroup Condition="'$(BetaUpdateRepository)' != ''">
        <AssemblyMetadata Include="BetaUpdateRepository" Value="$(BetaUpdateRepository)" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.WindowsAppSDK" GeneratePathProperty="true" />
        <PackageReference Include="CommunityToolkit.Mvvm" />
        <PackageReference Include="Velopack" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="../UsbDisplayHost.Core/UsbDisplayHost.Core.csproj" />
        <ProjectReference Include="../UsbDisplayHost.Windows/UsbDisplayHost.Windows.csproj" />
        <ProjectReference Include="../UsbDisplayHost.Rendering/UsbDisplayHost.Rendering.csproj" />
    </ItemGroup>
    <ItemGroup>
        <Compile Include="$(DesktopSource)/ViewModels/*.cs" LinkBase="Shared/ViewModels" />
        <Compile Include="$(DesktopSource)/Services/DeviceDiscoveryLifetime.cs" LinkBase="Shared/Services" />
        <Compile Include="$(DesktopSource)/Services/DeviceDiscoveryPresenter.cs" LinkBase="Shared/Services" />
        <Compile Include="$(DesktopSource)/Services/DeviceProtocolService*.cs" LinkBase="Shared/Services" />
        <Compile Include="$(DesktopSource)/Services/DeviceSessionLifetime.cs" LinkBase="Shared/Services" />
        <Compile Include="$(DesktopSource)/Services/DeviceSnapshotPresenter.cs" LinkBase="Shared/Services" />
        <Compile Include="$(DesktopSource)/Services/DraftPreviewController.cs" LinkBase="Shared/Services" />
        <Compile Include="$(DesktopSource)/Services/IExportDestinationPicker.cs" LinkBase="Shared/Services" />
        <Compile Include="$(DesktopSource)/Services/IFramePreviewDecoder.cs" LinkBase="Shared/Services" />
        <Compile Include="$(DesktopSource)/Services/IImagePicker.cs" LinkBase="Shared/Services" />
        <Compile Include="$(DesktopSource)/Services/IUiDispatcher.cs" LinkBase="Shared/Services" />
        <Compile Include="$(DesktopSource)/Services/IWindowExitHost.cs" LinkBase="Shared/Services" />
        <Compile Include="$(DesktopSource)/Services/ModeSwitchNoticeService.cs" LinkBase="Shared/Services" />
        <Compile Include="$(DesktopSource)/Services/PowerSessionLifetime.cs" LinkBase="Shared/Services" />
        <Compile Include="$(DesktopSource)/Services/ThemeApplicationResultFormatter.cs" LinkBase="Shared/Services" />
        <Compile Include="$(DesktopSource)/Services/ThemeWorkspaceLifetime.cs" LinkBase="Shared/Services" />
        <Compile Include="$(DesktopSource)/Services/WindowExitWorkflow.cs" LinkBase="Shared/Services" />
        <Compile Include="$(DesktopSource)/Services/WorkspaceNoticeLifetime.cs" LinkBase="Shared/Services" />
    </ItemGroup>
    <ItemGroup>
        <Content Include="$(DesktopSource)/Assets/Branding/app.ico"
                 Link="Assets/Branding/app.ico"
                 CopyToOutputDirectory="PreserveNewest"
                 CopyToPublishDirectory="PreserveNewest" />
        <Content Include="../../licenses/**/*" Exclude="../../licenses/WPF-UI/**/*"
                 Link="licenses/%(RecursiveDir)%(Filename)%(Extension)"
                 CopyToPublishDirectory="PreserveNewest" />
        <Content Include="$(PkgMicrosoft_WindowsAppSDK)/license.txt;$(PkgMicrosoft_WindowsAppSDK)/NOTICE.txt"
                 Link="licenses/WindowsAppSDK/%(Filename)%(Extension)"
                 CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

    <!-- 非 MSIX 构建生成包含 XBF 的项目 PRI，当前 App SDK 不会自动纳入发布目录。 -->
    <Target Name="IncludeWinUiResourceIndex" BeforeTargets="ComputeResolvedFilesToPublishList"
            Condition="'$(WindowsPackageType)' == 'None'">
        <Error Condition="!Exists('$(ProjectPriFullPath)')" Text="未生成 WinUI 应用资源索引：$(ProjectPriFullPath)" />
        <ItemGroup>
            <ResolvedFileToPublish Include="$(ProjectPriFullPath)"
                                   RelativePath="$(ProjectPriFileName)"
                                   CopyToPublishDirectory="PreserveNewest" />
        </ItemGroup>
    </Target>
</Project>
