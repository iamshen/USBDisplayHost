<Page
    x:Class="UsbDisplayHost.WinUI.Views.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:UsbDisplayHost.Desktop.ViewModels"
    xmlns:views="using:UsbDisplayHost.WinUI.Views">
    <Page.Resources>
        <views:DeviceValueVisibilityConverter x:Key="DeviceValueVisibility" />
        <Style x:Key="DiagnosticErrorTextStyle" TargetType="TextBlock" BasedOn="{StaticResource WorkspaceSupportingTextStyle}">
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            <Setter Property="IsTextSelectionEnabled" Value="True" />
        </Style>
    </Page.Resources>

    <Grid Padding="48,29,48,24" RowDefinitions="Auto,Auto,Auto,Auto,*">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock Text="诊断" Style="{StaticResource WorkspaceStateHeadingStyle}"
                       AutomationProperties.HeadingLevel="Level1" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="打开日志目录" Command="{Binding OpenLogsCommand}" Style="{StaticResource WorkspaceGhostButton}" MinWidth="141" />
                <Button Content="导出诊断…" Command="{Binding ExportCommand}" Style="{StaticResource WorkspaceSecondaryButton}" MinWidth="155" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="14" Margin="0,36,0,0">

            <Border Style="{StaticResource WorkspacePanelStyle}" MinHeight="111" Padding="18,16,18,12">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="TransferSummaryLabel" Text="传输状态" Style="{StaticResource WorkspaceSupportingTextStyle}" />
                    <TextBlock x:Name="TransferSummary" Text="{Binding ConnectionSummary}" Style="{StaticResource WorkspaceStateHeadingStyle}"
                               AutomationProperties.LabeledBy="{Binding ElementName=TransferSummaryLabel}" />
                    <TextBlock Text="主机推流" FontSize="12" Foreground="{ThemeResource WorkspaceTextSecondaryBrush}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource WorkspacePanelStyle}" MinHeight="111" Padding="18,16,18,12">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="FrameCountLabel" Text="USB 已发送帧数" Style="{StaticResource WorkspaceSupportingTextStyle}" />
                    <TextBlock Text="{Binding CompletedFramesText}" Style="{StaticResource WorkspaceStateHeadingStyle}"
                               AutomationProperties.LabeledBy="{Binding ElementName=FrameCountLabel}" />
                    <TextBlock Text="当前会话" FontSize="12" Foreground="{ThemeResource WorkspaceTextSecondaryBrush}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource WorkspacePanelStyle}" MinHeight="111" Padding="18,16,18,12">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="LogStateLabel" Text="日志写入" Style="{StaticResource WorkspaceSupportingTextStyle}" />
                    <TextBlock x:Name="LogState" Text="{Binding LogStateText}" Style="{StaticResource WorkspaceStateHeadingStyle}"
                               AutomationProperties.LabeledBy="{Binding ElementName=LogStateLabel}" />
                    <TextBlock Text="本地诊断日志" FontSize="12" Foreground="{ThemeResource WorkspaceTextSecondaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Spacing="8" Margin="0,16,0,0">
            <ToggleButton x:Name="RunDetailsToggle" MinHeight="34" CornerRadius="17" Padding="8,4,12,4"
                          Background="Transparent" BorderThickness="0" AutomationProperties.Name="运行详情">
                <ToggleButton.Resources>
                    <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="Transparent" />
                </ToggleButton.Resources>
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <FontIcon Glyph="{x:Bind views:DiagnosticsPage.DisclosureGlyph(RunDetailsToggle.IsChecked), Mode=OneWay}" FontSize="11"
                              AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock Text="运行详情" />
                </StackPanel>
            </ToggleButton>
            <ScrollViewer MaxHeight="152" Margin="16,0,0,0" HorizontalContentAlignment="Stretch"
                          Visibility="{Binding IsChecked, ElementName=RunDetailsToggle, Converter={StaticResource DeviceValueVisibility}}">
                <Grid ColumnDefinitions="80,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="10">
                    <TextBlock Text="主机管线" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2" />
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="{Binding HostTransferText}" Style="{StaticResource WorkspaceSupportingTextStyle}" />
                        <TextBlock Text="{Binding ActiveProductionText}"
                                   Visibility="{Binding ActiveProductionText, Converter={StaticResource DeviceValueVisibility}}"
                                   Style="{StaticResource WorkspaceSupportingTextStyle}" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="设备反馈" FontWeight="SemiBold"
                               AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DeviceFeedbackText}"
                               Style="{StaticResource WorkspaceSupportingTextStyle}" />
                    <TextBlock Grid.Row="2" Text="日志存储" FontWeight="SemiBold"
                               AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding StorageText}"
                               Style="{StaticResource WorkspaceSupportingTextStyle}" />
                </Grid>
            </ScrollViewer>
        </StackPanel>

        <StackPanel Grid.Row="3" Spacing="8" VerticalAlignment="Top">
            <TextBlock
                x:Name="RefreshErrorText"
                Visibility="Collapsed"
                Style="{StaticResource DiagnosticErrorTextStyle}"
                AutomationProperties.LiveSetting="Polite" />
            <TextBlock Text="{Binding TransferErrorText}"
                       Visibility="{Binding TransferErrorText, Converter={StaticResource DeviceValueVisibility}}"
                       Style="{StaticResource DiagnosticErrorTextStyle}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="取消导出" Command="{Binding ExportCancelCommand}"
                        Visibility="{Binding ExportCommand.IsRunning, Converter={StaticResource DeviceValueVisibility}}" />
                <Button Content="核实导出" Command="{Binding VerifyExportCommand}"
                        Visibility="{Binding HasUnconfirmedExport, Converter={StaticResource DeviceValueVisibility}}" />
                <Button Content="取消核实" Command="{Binding VerifyExportCancelCommand}"
                        Visibility="{Binding VerifyExportCommand.IsRunning, Converter={StaticResource DeviceValueVisibility}}" />
                <Button Content="放弃核实" Command="{Binding DiscardExportVerificationCommand}"
                        Visibility="{Binding HasUnconfirmedExport, Converter={StaticResource DeviceValueVisibility}}" />
            </StackPanel>
            <TextBlock Text="{Binding ActionText}"
                       Visibility="{Binding ActionText, Converter={StaticResource DeviceValueVisibility}}"
                       Style="{StaticResource WorkspaceSupportingTextStyle}" IsTextSelectionEnabled="True"
                       AutomationProperties.LiveSetting="Polite" />
            <ProgressBar Minimum="0" Maximum="100" Value="{Binding ExportProgress, Mode=OneWay}"
                         Visibility="{Binding ExportCommand.IsRunning, Converter={StaticResource DeviceValueVisibility}}"
                         AutomationProperties.Name="诊断导出进度" />
        </StackPanel>

        <Grid Grid.Row="4" RowDefinitions="Auto,Auto,*" Margin="0,26,0,0">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Text="事件日志" Style="{StaticResource WorkspaceSectionHeadingStyle}"
                           AutomationProperties.HeadingLevel="Level2" />
                <TextBlock Grid.Column="1" Text="{Binding EventCountText}" Style="{StaticResource WorkspaceSupportingTextStyle}"
                           VerticalAlignment="Center" />
            </Grid>
            <Border x:Name="EventHeader" Grid.Row="1" Visibility="Collapsed" Margin="0,18,0,4"
                    Background="{ThemeResource WorkspaceNavigationBrush}" CornerRadius="8" Padding="16,8">
                <Grid ColumnDefinitions="134,111,*,141" ColumnSpacing="10">
                    <TextBlock Text="时间" Style="{StaticResource WorkspaceSupportingTextStyle}" />
                    <TextBlock Grid.Column="1" Text="级别" Style="{StaticResource WorkspaceSupportingTextStyle}" />
                    <TextBlock Grid.Column="2" Text="阶段 / 事件" Style="{StaticResource WorkspaceSupportingTextStyle}" />
                    <TextBlock Grid.Column="3" Text="错误编号" Style="{StaticResource WorkspaceSupportingTextStyle}" />
                </Grid>
            </Border>

            <ListView
                x:Name="EventList"
                Grid.Row="2"
                ItemsSource="{Binding Events}"
                Visibility="Collapsed"
                SelectionMode="Single"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                AutomationProperties.Name="最近诊断事件">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate><ItemsStackPanel /></ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:DiagnosticRow">
                        <Border BorderBrush="{ThemeResource WorkspaceDividerBrush}" BorderThickness="0,0,0,1"
                                Padding="16,8" MinHeight="43">
                            <Grid ColumnDefinitions="134,111,*,141" ColumnSpacing="10" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Timestamp}" Style="{StaticResource WorkspaceSupportingTextStyle}"
                                           FontFamily="Consolas" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Severity}" Foreground="{x:Bind views:DiagnosticsPage.SeverityBrush(Severity)}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind views:DiagnosticsPage.EventText(Stage, Code)}" TextWrapping="Wrap" />
                                <TextBlock Grid.Column="3" Text="{x:Bind ErrorId}" Style="{StaticResource WorkspaceSupportingTextStyle}"
                                           FontFamily="Consolas" FontSize="12" IsTextSelectionEnabled="True" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock x:Name="EmptyEvents" Grid.Row="2" Text="暂无诊断事件"
                       Style="{StaticResource WorkspaceSupportingTextStyle}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Page>
