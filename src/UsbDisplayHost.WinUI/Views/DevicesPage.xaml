<Page
    x:Class="UsbDisplayHost.WinUI.Views.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:UsbDisplayHost.WinUI.Views">
    <Page.Resources>
        <views:DeviceValueVisibilityConverter x:Key="DeviceValueVisibility" />
        <Style x:Key="DeviceErrorStyle" TargetType="TextBlock" BasedOn="{StaticResource WorkspaceSupportingTextStyle}">
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            <Setter Property="IsTextSelectionEnabled" Value="True" />
        </Style>
    </Page.Resources>

    <ScrollViewer HorizontalContentAlignment="Stretch">
        <StackPanel Margin="24,40,24,32" MaxWidth="1056" Spacing="24">
            <StackPanel HorizontalAlignment="Center" Spacing="12">
                <Border
                    x:Name="EmptyDeviceIcon"
                    Width="76"
                    Height="76"
                    HorizontalAlignment="Center"
                    Background="{ThemeResource WorkspaceNavigationBrush}"
                    BorderBrush="{ThemeResource WorkspaceDividerBrush}"
                    BorderThickness="1"
                    CornerRadius="24">
                    <FontIcon
                        Glyph="&#xE7F4;"
                        FontSize="36"
                        Foreground="{ThemeResource WorkspaceTextPrimaryBrush}"
                        AutomationProperties.AccessibilityView="Raw" />
                </Border>
                <TextBlock
                    x:Name="ConnectionHeading"
                    Text="未连接设备"
                    Style="{StaticResource WorkspaceStateHeadingStyle}"
                    TextAlignment="Center"
                    AutomationProperties.HeadingLevel="Level1" />
                <TextBlock
                    x:Name="CurrentDeviceText"
                    Text="{Binding DeviceText}"
                    Visibility="Collapsed"
                    Style="{StaticResource WorkspaceSupportingTextStyle}"
                    TextAlignment="Center"
                    IsTextSelectionEnabled="True" />
                <TextBlock
                    x:Name="NoDeviceHelp"
                    Style="{StaticResource WorkspaceSupportingTextStyle}"
                    TextAlignment="Center" />
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="RescanButton" Content="重新检测" Command="{Binding RescanCommand}" />
                    <Button x:Name="DisconnectButton" Content="{Binding DisconnectActionText}"
                            Command="{Binding DisconnectCommand}" Visibility="Collapsed" />
                    <Button x:Name="ThemeButton" Content="先预览主题" Visibility="Collapsed" Click="OnThemeClick" />
                    <Button Content="查看诊断" Click="OnDiagnosticsClick" />
                </StackPanel>
            </StackPanel>

            <StackPanel HorizontalAlignment="Center" Spacing="8">
                <TextBlock
                    Text="{Binding ProtocolText}"
                    Visibility="{Binding ProtocolText, Converter={StaticResource DeviceValueVisibility}}"
                    Style="{StaticResource WorkspaceSupportingTextStyle}"
                    TextAlignment="Center"
                    AutomationProperties.LiveSetting="Polite" />
                <TextBlock
                    Text="{Binding ProtocolErrorText}"
                    Visibility="{Binding ProtocolErrorText, Converter={StaticResource DeviceValueVisibility}}"
                    Style="{StaticResource DeviceErrorStyle}" />
                <TextBlock
                    Text="{Binding DeviceErrorText}"
                    Visibility="{Binding DeviceErrorText, Converter={StaticResource DeviceValueVisibility}}"
                    Style="{StaticResource DeviceErrorStyle}" />
                <TextBlock
                    Text="{Binding SubscriptionErrorText}"
                    Visibility="{Binding SubscriptionErrorText, Converter={StaticResource DeviceValueVisibility}}"
                    Style="{StaticResource DeviceErrorStyle}" />
                <Button
                    Content="取消操作"
                    Command="{Binding CancelProtocolCommand}"
                    Visibility="{Binding IsProtocolBusy, Converter={StaticResource DeviceValueVisibility}}"
                    HorizontalAlignment="Center" />
            </StackPanel>

            <Grid x:Name="CurrentWorkspace" Visibility="Collapsed" ColumnSpacing="16" RowSpacing="16"
                  SizeChanged="OnWorkspaceSizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource WorkspacePanelStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock
                            Text="主机活动预览"
                            Style="{StaticResource WorkspaceSectionHeadingStyle}"
                            AutomationProperties.HeadingLevel="Level2" />
                        <Viewbox MaxHeight="300" StretchDirection="DownOnly">
                            <Border Width="576" Height="324" CornerRadius="8"
                                    Background="{ThemeResource WorkspaceCanvasBrush}"
                                    BorderBrush="{ThemeResource WorkspaceDividerBrush}" BorderThickness="1">
                                <Image Source="{Binding HostPreview}" Stretch="Uniform"
                                       AutomationProperties.Name="主机画面预览" />
                            </Border>
                        </Viewbox>
                        <TextBlock Text="{Binding HostPreviewText}" Style="{StaticResource WorkspaceSupportingTextStyle}" />
                        <TextBlock
                            Text="{Binding HostPreviewErrorText}"
                            Visibility="{Binding HostPreviewErrorText, Converter={StaticResource DeviceValueVisibility}}"
                            Style="{StaticResource DeviceErrorStyle}" />
                        <Button
                            Content="重试预览"
                            Command="{Binding RetryHostPreviewCommand}"
                            Visibility="{Binding HostPreviewErrorText, Converter={StaticResource DeviceValueVisibility}}" />
                    </StackPanel>
                </Border>

                <Border x:Name="SessionPanel" Grid.Column="1" Style="{StaticResource WorkspacePanelStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="当前设备状态" Style="{StaticResource WorkspaceSectionHeadingStyle}"
                                   AutomationProperties.HeadingLevel="Level2" />
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                            <TextBlock x:Name="ModeLabel" Text="显示模式" Style="{StaticResource WorkspaceSupportingTextStyle}" />
                            <TextBlock x:Name="ModeText" Grid.Column="1" HorizontalAlignment="Right"
                                       AutomationProperties.LabeledBy="{Binding ElementName=ModeLabel}" />
                            <TextBlock x:Name="PowerLabel" Text="屏幕电源" Grid.Row="1" Style="{StaticResource WorkspaceSupportingTextStyle}" />
                            <TextBlock x:Name="PowerText" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right"
                                       AutomationProperties.LabeledBy="{Binding ElementName=PowerLabel}" />
                            <TextBlock x:Name="StreamingLabel" Text="画面发送" Grid.Row="2" Style="{StaticResource WorkspaceSupportingTextStyle}" />
                            <TextBlock x:Name="StreamingText" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Right"
                                       AutomationProperties.LabeledBy="{Binding ElementName=StreamingLabel}" />
                            <TextBlock x:Name="ResolutionLabel" Text="分辨率" Grid.Row="3" Style="{StaticResource WorkspaceSupportingTextStyle}" />
                            <TextBlock Text="{Binding ResolutionText}" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Right"
                                       AutomationProperties.LabeledBy="{Binding ElementName=ResolutionLabel}" />
                            <TextBlock Text="设备反馈亮度" Grid.Row="4" Style="{StaticResource WorkspaceSupportingTextStyle}"
                                       x:Name="BrightnessLabel" />
                            <TextBlock Text="{Binding BrightnessText}" Grid.Row="4" Grid.Column="1" HorizontalAlignment="Right"
                                       AutomationProperties.LabeledBy="{Binding ElementName=BrightnessLabel}" />
                        </Grid>
                        <StackPanel Spacing="8">
                            <Button x:Name="SwitchThemeButton" Content="切换到主题模式"
                                    Command="{Binding SwitchThemeCommand}" Visibility="Collapsed" />
                            <Button x:Name="SwitchScreenButton" Content="切换到副屏模式"
                                    Command="{Binding SwitchScreenCommand}" Visibility="Collapsed" />
                            <TextBlock x:Name="ModeUnavailableReason" Text="屏幕已熄灭，唤醒后可切换模式。"
                                       Visibility="Collapsed" Style="{StaticResource WorkspaceSupportingTextStyle}" />
                            <Button x:Name="SleepButton" Content="熄屏" Command="{Binding SleepDisplayCommand}" Visibility="Collapsed" />
                            <Button x:Name="WakeButton" Content="唤醒" Command="{Binding WakeDisplayCommand}" Visibility="Collapsed" />
                            <Button x:Name="PauseButton" Content="暂停播放" Command="{Binding PauseStreamingCommand}" Visibility="Collapsed" />
                            <Button x:Name="ResumeButton" Content="恢复播放" Command="{Binding ResumeStreamingCommand}" Visibility="Collapsed" />
                        </StackPanel>
                        <TextBlock Text="{Binding StreamingResultText}"
                                   Visibility="{Binding StreamingResultText, Converter={StaticResource DeviceValueVisibility}}"
                                   Style="{StaticResource WorkspaceSupportingTextStyle}" />
                        <TextBlock Text="{Binding StreamingErrorText}"
                                   Visibility="{Binding StreamingErrorText, Converter={StaticResource DeviceValueVisibility}}"
                                   Style="{StaticResource DeviceErrorStyle}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border x:Name="DiscoveryPanel" Style="{StaticResource WorkspacePanelStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="检测到的设备" Style="{StaticResource WorkspaceSectionHeadingStyle}"
                               AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Text="{Binding DiscoveryStatusText}" Style="{StaticResource WorkspaceSupportingTextStyle}"
                               AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Text="{Binding DiscoveryErrorText}"
                               Visibility="{Binding DiscoveryErrorText, Converter={StaticResource DeviceValueVisibility}}"
                               Style="{StaticResource DeviceErrorStyle}" />
                    <StackPanel x:Name="CandidatePanel" Visibility="Collapsed" Spacing="12">
                        <ListView x:Name="CandidateList" MaxHeight="240" SelectionMode="Single"
                                  SelectedItem="{Binding SelectedCandidate, Mode=TwoWay}"
                                  AutomationProperties.Name="检测到的设备列表">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Padding="0,6" Spacing="4">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding InterfacesText}" Style="{StaticResource WorkspaceSupportingTextStyle}" />
                                        <TextBlock Text="{Binding ErrorText}"
                                                   Visibility="{Binding ErrorText, Converter={StaticResource DeviceValueVisibility}}"
                                                   Style="{StaticResource DeviceErrorStyle}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="选择设备" Command="{Binding ConfirmSelectionCommand}" />
                            <Button Content="连接设备" Command="{Binding ConnectProtocolCommand}" Style="{StaticResource AccentButtonStyle}" />
                        </StackPanel>
                        <TextBlock Text="{Binding SelectionText}" Style="{StaticResource WorkspaceSupportingTextStyle}"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Spacing="8">
                <TextBlock Text="{Binding LifecycleText}"
                           Visibility="{Binding LifecycleText, Converter={StaticResource DeviceValueVisibility}}"
                           Style="{StaticResource WorkspaceSupportingTextStyle}" />
                <TextBlock Text="{Binding LifecycleErrorText}"
                           Visibility="{Binding LifecycleErrorText, Converter={StaticResource DeviceValueVisibility}}"
                           Style="{StaticResource DeviceErrorStyle}" />
                <TextBlock Text="{Binding DisconnectText}"
                           Visibility="{Binding DisconnectText, Converter={StaticResource DeviceValueVisibility}}"
                           Style="{StaticResource WorkspaceSupportingTextStyle}" />
                <TextBlock Text="{Binding DisconnectErrorText}"
                           Visibility="{Binding DisconnectErrorText, Converter={StaticResource DeviceValueVisibility}}"
                           Style="{StaticResource DeviceErrorStyle}" />
                <TextBlock Text="{Binding PendingSaveText}"
                           Visibility="{Binding PendingSaveText, Converter={StaticResource DeviceValueVisibility}}"
                           Style="{StaticResource WorkspaceSupportingTextStyle}" />
                <TextBlock Text="{Binding PendingSaveErrorText}"
                           Visibility="{Binding PendingSaveErrorText, Converter={StaticResource DeviceValueVisibility}}"
                           Style="{StaticResource DeviceErrorStyle}" />
                <TextBlock Text="{Binding LocalSaveResultText}"
                           Visibility="{Binding LocalSaveResultText, Converter={StaticResource DeviceValueVisibility}}"
                           Style="{StaticResource WorkspaceSupportingTextStyle}" />
                <TextBlock Text="{Binding LocalSaveErrorText}"
                           Visibility="{Binding LocalSaveErrorText, Converter={StaticResource DeviceValueVisibility}}"
                           Style="{StaticResource DeviceErrorStyle}" />
                <Button Content="重试保存配置" Command="{Binding RetryPendingSaveCommand}"
                        Visibility="{Binding PendingSaveText, Converter={StaticResource DeviceValueVisibility}}" />
                <Button x:Name="RetrySettingsButton" Content="重试保存设置" Command="{Binding RetryProtocolSaveCommand}"
                        Visibility="{Binding IsEnabled, ElementName=RetrySettingsButton, Converter={StaticResource DeviceValueVisibility}}" />
            </StackPanel>

            <Expander x:Name="ConnectionDetails" Header="连接详情" Visibility="Collapsed" HorizontalAlignment="Stretch">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock x:Name="FirmwareLabel" Text="固件" Style="{StaticResource WorkspaceSupportingTextStyle}" />
                        <TextBlock Text="{Binding FirmwareText}" TextWrapping="Wrap"
                                   AutomationProperties.LabeledBy="{Binding ElementName=FirmwareLabel}" />
                    </StackPanel>
                    <TextBlock Text="{Binding OperationText}" Style="{StaticResource WorkspaceSupportingTextStyle}" />
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</Page>
