<UserControl
    x:Class="UsbDisplayHost.WinUI.Views.ThemesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:UsbDisplayHost.WinUI.Views">
    <UserControl.Resources>
        <views:DeviceValueVisibilityConverter x:Key="ContentVisibility" />
        <Style x:Key="ElementInputStyle" TargetType="NumberBox">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="SpinButtonPlacementMode" Value="Compact" />
            <Setter Property="SmallChange" Value="1" />
            <Setter Property="LargeChange" Value="10" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid x:Name="Gallery" Margin="40,32,40,34" RowDefinitions="Auto,*,Auto" RowSpacing="20">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <StackPanel Orientation="Horizontal" Spacing="10" AutomationProperties.Name="主题库来源">
                    <ToggleButton x:Name="PresetTab" Content="预设主题" Style="{StaticResource WorkspaceChoiceButton}" Click="OnPresetTabClick" />
                    <ToggleButton x:Name="MineTab" Content="我的主题" Style="{StaticResource WorkspaceChoiceButton}" Click="OnMineTabClick" />
                </StackPanel>
                <StackPanel x:Name="Filters" Grid.Column="1" Orientation="Horizontal" Spacing="2" AutomationProperties.Name="预设筛选">
                    <ToggleButton Content="全部" Tag="0" Style="{StaticResource WorkspaceChoiceButton}" Click="OnFilterClick" />
                    <ToggleButton Content="时钟" Tag="1" Style="{StaticResource WorkspaceChoiceButton}" Click="OnFilterClick" />
                    <ToggleButton Content="仪表盘" Tag="2" Style="{StaticResource WorkspaceChoiceButton}" Click="OnFilterClick" />
                    <ToggleButton Content="风景" Tag="3" Style="{StaticResource WorkspaceChoiceButton}" Click="OnFilterClick" />
                </StackPanel>
            </Grid>
            <ScrollViewer Grid.Row="1" HorizontalContentAlignment="Stretch">
                <Grid>
                    <Grid x:Name="GalleryGrid" Margin="0,19,0,4" ColumnSpacing="12" RowSpacing="23"
                          VerticalAlignment="Top" SizeChanged="OnGallerySizeChanged" />
                    <StackPanel x:Name="EmptyThemes" Visibility="Collapsed" HorizontalAlignment="Center"
                                VerticalAlignment="Center" Spacing="18" Padding="0,115,0,100">
                        <TextBlock Text="还没有保存的主题" Style="{StaticResource WorkspaceStateHeadingStyle}" />
                        <Button Content="浏览预设主题" Style="{StaticResource WorkspacePrimaryButton}"
                                HorizontalAlignment="Center" Click="OnPresetTabClick" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock x:Name="LibraryStatus" VerticalAlignment="Center" Style="{StaticResource WorkspaceSupportingTextStyle}"
                           AutomationProperties.LiveSetting="Polite" />
                <Button x:Name="OpenThemeButton" Grid.Column="1" MinWidth="204" Content="编辑主题"
                        Style="{StaticResource WorkspacePrimaryButton}" Click="OnOpenThemeClick" />
            </Grid>
        </Grid>

        <Grid x:Name="Editor" Visibility="Collapsed" Margin="36,5,38,21"
              RowDefinitions="Auto,*,Auto" RowSpacing="18">
            <StackPanel Orientation="Horizontal" Spacing="18">
                <Button Content="‹  主题库" Style="{StaticResource WorkspaceGhostButton}" Click="OnBackClick" />
                <Border Width="1" Height="20" Background="{ThemeResource WorkspaceDividerBrush}" />
                <TextBlock x:Name="EditorTitle" VerticalAlignment="Center" Style="{StaticResource WorkspaceSectionHeadingStyle}"
                           AutomationProperties.HeadingLevel="Level1" />
            </StackPanel>
            <ScrollViewer Grid.Row="1" HorizontalContentAlignment="Stretch">
                <Grid x:Name="EditorLayout" ColumnDefinitions="*,260" RowDefinitions="Auto,Auto" ColumnSpacing="28"
                      SizeChanged="OnEditorSizeChanged" VerticalAlignment="Top" Margin="0,14,0,0">
                    <StackPanel Spacing="11">
                        <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="10">
                            <TextBlock Text="本地预览" Style="{StaticResource WorkspaceSectionHeadingStyle}"
                                       VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level2" />
                            <Button x:Name="AddElementButton" Grid.Column="1" Content="＋ 添加元素" Style="{StaticResource WorkspaceGhostButton}">
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="时钟" Tag="Clock" Click="OnAddElement" />
                                        <MenuFlyoutSubItem Text="监测数据">
                                            <MenuFlyoutItem Text="CPU 使用率" Tag="CpuUsage" Click="OnAddElement" />
                                            <MenuFlyoutItem Text="内存占用" Tag="MemoryUsage" Click="OnAddElement" />
                                            <MenuFlyoutItem Text="主机温度" Tag="HostTemperature" Click="OnAddElement" />
                                            <MenuFlyoutItem Text="设备温度" Tag="DeviceTemperature" Click="OnAddElement" />
                                        </MenuFlyoutSubItem>
                                        <MenuFlyoutItem Text="图片…" Tag="Image" Click="OnAddElement" />
                                        <MenuFlyoutItem Text="文字" Tag="Text" Click="OnAddElement" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                            <Button x:Name="UndoButton" Grid.Column="2" Content="↶  撤销" Style="{StaticResource WorkspaceGhostButton}"
                                    IsEnabled="False" Click="OnUndoClick" />
                            <TextBlock Grid.Column="3" Text="1920 × 1080" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       FontFamily="Consolas" FontSize="12" Foreground="{ThemeResource WorkspaceTextSecondaryBrush}" />
                        </Grid>
                        <Border CornerRadius="12" BorderBrush="{ThemeResource WorkspaceDividerBrush}" BorderThickness="1"
                                Background="{ThemeResource WorkspacePreviewBrush}">
                            <ContentControl x:Name="PreviewInput" IsTabStop="True" Background="Transparent"
                                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                            AutomationProperties.Name="本地预览画布，方向键微调选中元素"
                                            PointerPressed="OnCanvasPressed" PointerMoved="OnCanvasMoved"
                                            PointerReleased="OnCanvasReleased" PointerCaptureLost="OnCanvasCaptureLost"
                                            KeyDown="OnCanvasKeyDown">
                                <Viewbox Stretch="Uniform">
                                    <Grid x:Name="SceneSurface" Width="1920" Height="1080" Background="Transparent">
                                        <Image x:Name="PreviewImage" Stretch="Fill" IsHitTestVisible="False"
                                               AutomationProperties.AccessibilityView="Raw" />
                                        <Canvas x:Name="SelectionOverlay" IsHitTestVisible="False" />
                                    </Grid>
                                </Viewbox>
                            </ContentControl>
                        </Border>
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding PreviewErrorText}" Style="{StaticResource WorkspaceSupportingTextStyle}"
                                       Visibility="{Binding PreviewErrorText, Converter={StaticResource ContentVisibility}}" />
                            <Button Content="重试预览" Command="{Binding RetryPreviewCommand}"
                                    Visibility="{Binding PreviewErrorText, Converter={StaticResource ContentVisibility}}" />
                        </StackPanel>
                    </StackPanel>
                    <Border x:Name="PropertyColumn" Grid.Column="1" Padding="20,0,0,0"
                            BorderThickness="1,0,0,0" BorderBrush="{ThemeResource WorkspaceDividerBrush}">
                        <StackPanel Spacing="13">
                            <TextBlock Text="元素" Style="{StaticResource WorkspaceSectionHeadingStyle}" AutomationProperties.HeadingLevel="Level2" />
                            <ListView x:Name="ElementList" MaxHeight="190" SelectionChanged="OnElementSelected"
                                      AutomationProperties.Name="主题元素">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="MinHeight" Value="40" />
                                        <Setter Property="CornerRadius" Value="8" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                            </ListView>
                            <ContentControl x:Name="PropertyInputs" HorizontalContentAlignment="Stretch">
                            <StackPanel x:Name="Properties" Spacing="12">
                                <Border Height="1" Background="{ThemeResource WorkspaceDividerBrush}" />
                                <TextBlock Text="位置" FontWeight="SemiBold" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <NumberBox x:Name="ElementX" Header="X" Style="{StaticResource ElementInputStyle}"
                                               AutomationProperties.Name="元素 X 坐标" ValueChanged="OnPositionChanged" />
                                    <NumberBox x:Name="ElementY" Grid.Column="1" Header="Y" Style="{StaticResource ElementInputStyle}"
                                               AutomationProperties.Name="元素 Y 坐标" ValueChanged="OnPositionChanged" />
                                </Grid>
                                <Grid x:Name="FontRow" ColumnDefinitions="*,110">
                                    <TextBlock Text="字号" VerticalAlignment="Center" />
                                    <NumberBox x:Name="ElementFont" Grid.Column="1" Style="{StaticResource ElementInputStyle}"
                                               Minimum="12" Maximum="440" ValueChanged="OnFontChanged" AutomationProperties.Name="字号" />
                                </Grid>
                                <Grid x:Name="ColorRow" ColumnDefinitions="*,120">
                                    <TextBlock Text="文字颜色" VerticalAlignment="Center" />
                                    <TextBox x:Name="ElementColor" Grid.Column="1" FontFamily="Consolas" MaxLength="7"
                                             LostFocus="OnColorLost" KeyDown="OnColorKeyDown" AutomationProperties.Name="文字颜色" />
                                </Grid>
                                <TextBox x:Name="ElementText" Header="文字内容" MaxLength="120"
                                         LostFocus="OnTextLost" KeyDown="OnTextKeyDown" />
                                <CheckBox x:Name="Clock24Hours" Content="24 小时制" Click="OnClockFormatChanged" />
                                <ComboBox x:Name="ElementFit" Header="图片适配" SelectionChanged="OnFitChanged">
                                    <x:String>完整显示</x:String>
                                    <x:String>填充裁剪</x:String>
                                </ComboBox>
                                <Border Height="1" Background="{ThemeResource WorkspaceDividerBrush}" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="5">
                                    <TextBlock Text="拖动移动 · 方向键微调" VerticalAlignment="Center" FontSize="12"
                                               TextWrapping="Wrap" Foreground="{ThemeResource WorkspaceTextSecondaryBrush}" />
                                    <Button Grid.Column="1" Content="移除" Style="{StaticResource WorkspaceGhostButton}"
                                            AutomationProperties.Name="移除选中元素" Click="OnRemoveClick" />
                                </Grid>
                            </StackPanel>
                            </ContentControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
            <Grid Grid.Row="2" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="18">
                <StackPanel Spacing="4" VerticalAlignment="Center">
                    <TextBlock x:Name="EditStatus" Style="{StaticResource WorkspaceSupportingTextStyle}" AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Text="{Binding ApplicationText}" Style="{StaticResource WorkspaceSupportingTextStyle}"
                               Visibility="{Binding ApplicationText, Converter={StaticResource ContentVisibility}}" AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Text="{Binding ErrorText}" Style="{StaticResource WorkspaceSupportingTextStyle}"
                               Foreground="{ThemeResource WorkspaceErrorBrush}" Visibility="{Binding ErrorText, Converter={StaticResource ContentVisibility}}" />
                    <Button Content="重试本地保存" Command="{Binding RetryApplicationSaveCommand}"
                            Visibility="{Binding HasApplicationSave, Converter={StaticResource ContentVisibility}}" />
                    <Button Content="取消应用" Command="{Binding ApplyCancelCommand}"
                            Visibility="{Binding IsApplying, Converter={StaticResource ContentVisibility}}" />
                </StackPanel>
                <Button Grid.Column="1" Content="{Binding ApplyLabel}" Command="{Binding ApplyCommand}"
                        MinWidth="172" MinHeight="46" Style="{StaticResource WorkspaceSecondaryButton}" />
                <Button x:Name="SaveButton" Grid.Column="2" Content="保存主题" MinWidth="196"
                        Style="{StaticResource WorkspacePrimaryButton}" Click="OnSaveClick" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding EditorStatus}"
                           FontSize="12" HorizontalAlignment="Center" MaxWidth="178" TextWrapping="Wrap"
                           Foreground="{ThemeResource WorkspaceTextSecondaryBrush}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
