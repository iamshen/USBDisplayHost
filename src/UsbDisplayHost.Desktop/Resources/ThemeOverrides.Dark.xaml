<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="CanvasBrushColor">#14171B</Color>
    <SolidColorBrush x:Key="CanvasBrush" Color="{DynamicResource CanvasBrushColor}" />
    <Color x:Key="SurfaceBrushColor">#1C2026</Color>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{DynamicResource SurfaceBrushColor}" />
    <Color x:Key="NavigationBrushColor">#111419</Color>
    <SolidColorBrush x:Key="NavigationBrush" Color="{DynamicResource NavigationBrushColor}" />
