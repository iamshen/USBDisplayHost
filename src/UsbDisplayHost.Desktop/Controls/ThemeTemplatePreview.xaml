<UserControl x:Class="UsbDisplayHost.Desktop.Controls.ThemeTemplatePreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:themes="clr-namespace:UsbDisplayHost.Desktop.ViewModels"
             Width="160" Height="90" Focusable="False" IsTabStop="False" IsHitTestVisible="False">
    <UserControl.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
            <Setter Property="LineHeight" Value="Auto" />
            <Setter Property="LineStackingStrategy" Value="MaxHeight" />
        </Style>
        <DataTemplate x:Key="ImageSample">
            <Canvas Width="96" Height="54" Background="{DynamicResource CanvasBrush}" ClipToBounds="True">
                <Ellipse Width="9" Height="9" Fill="{DynamicResource SelectedOutlineBrush}" Canvas.Left="68" Canvas.Top="10" />
                <Path Data="M0,54 L32,20 L68,54 Z" Fill="{DynamicResource TextSecondaryBrush}" />
                <Path Data="M40,54 L70,30 L96,54 Z" Fill="{DynamicResource SurfaceRaisedBrush}" />
            </Canvas>
        </DataTemplate>
        <DataTemplate x:Key="ClockSample">
            <Grid Width="160" Height="90" Background="{DynamicResource CanvasBrush}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="12:34" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="30" FontWeight="SemiBold" TextAlignment="Center" />
                    <TextBlock Text="日期 · 星期" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9" TextAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="DashboardSample">
            <Grid Width="160" Height="90" Background="{DynamicResource CanvasBrush}">
                <Grid Margin="10,10">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                    <Border Grid.RowSpan="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" />
                    <Border Grid.ColumnSpan="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" />
                    <StackPanel Margin="6,0">
                        <TextBlock Text="CPU" FontSize="8" LineHeight="10" LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="— %" FontSize="15" LineHeight="19" LineStackingStrategy="BlockLineHeight" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="内存" FontSize="8" LineHeight="10" LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="— %" FontSize="15" LineHeight="19" LineStackingStrategy="BlockLineHeight" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="6,4,0,0">
                        <TextBlock Text="主机温度" FontSize="8" LineHeight="10" LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="— °C" FontSize="15" LineHeight="19" LineStackingStrategy="BlockLineHeight" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,4,0,0">
                        <TextBlock Text="设备温度" FontSize="8" LineHeight="10" LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="— °C" FontSize="15" LineHeight="19" LineStackingStrategy="BlockLineHeight" FontWeight="SemiBold" />
                    </StackPanel>
                </Grid>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <Grid ClipToBounds="True">
        <Viewbox Stretch="Uniform">
            <Viewbox.Style>
                <Style TargetType="Viewbox">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Source, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Viewbox.Style>
            <ContentControl Content="{Binding Value, RelativeSource={RelativeSource AncestorType=UserControl}}" Focusable="False" IsTabStop="False" AutomationProperties.Name="模板布局示意">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="ContentTemplate" Value="{StaticResource ImageSample}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Value, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static themes:ThemeKind.Clock}">
                                <Setter Property="ContentTemplate" Value="{StaticResource ClockSample}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Value, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static themes:ThemeKind.Dashboard}">
                                <Setter Property="ContentTemplate" Value="{StaticResource DashboardSample}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </Viewbox>
        <Image Source="{Binding Source, RelativeSource={RelativeSource AncestorType=UserControl}}" Stretch="Uniform" />
    </Grid>
</UserControl>
