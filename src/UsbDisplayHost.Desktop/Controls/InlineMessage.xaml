<UserControl x:Class="UsbDisplayHost.Desktop.Controls.InlineMessage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <Trigger Property="Tag" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
    <Border BorderBrush="{DynamicResource ControlBorderBrush}"
            Background="{DynamicResource SurfaceBrush}"
            BorderThickness="1" CornerRadius="{DynamicResource SurfaceCornerRadius}" Padding="12">
        <TextBlock Text="{Binding Message, ElementName=Root}" Style="{DynamicResource BodyTextStyle}"
                   AutomationProperties.LiveSetting="Assertive" />
    </Border>
</UserControl>
