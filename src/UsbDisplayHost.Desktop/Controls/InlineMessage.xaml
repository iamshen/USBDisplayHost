<UserControl x:Class="UsbDisplayHost.Desktop.Controls.InlineMessage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="Root">
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <Trigger Property="Tag" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
                <Trigger Property="Tag" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
    <Border BorderBrush="{DynamicResource BorderBrush}"
            Background="{DynamicResource SurfaceBrush}"
            BorderThickness="1" CornerRadius="{DynamicResource SurfaceCornerRadius}" Padding="12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:SymbolIcon Symbol="Info20" FontSize="18" Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Top" Margin="0,2,10,0" />
            <TextBlock Grid.Column="1" Text="{Binding Message, ElementName=Root}" Style="{DynamicResource BodyTextStyle}"
                       AutomationProperties.LiveSetting="Assertive" />
        </Grid>
    </Border>
</UserControl>
