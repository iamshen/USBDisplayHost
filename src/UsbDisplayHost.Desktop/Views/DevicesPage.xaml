<Page x:Class="UsbDisplayHost.Desktop.Views.DevicesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:UsbDisplayHost.Desktop.Controls"
      xmlns:sessions="clr-namespace:UsbDisplayHost.Core.Sessions;assembly=UsbDisplayHost.Core"
      Title="设备" ScrollViewer.CanContentScroll="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="{DynamicResource PageContentMargin}">
        <StackPanel MaxWidth="1120">
            <DockPanel Margin="0,0,0,24">
                <Button DockPanel.Dock="Right" Content="重新检测" Command="{Binding RescanCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16,0,0,0" />
                <StackPanel>
                    <TextBlock Text="设备" Style="{DynamicResource PageTitleStyle}" />
                    <TextBlock Text="连接显示设备，管理画面与运行状态。" Style="{DynamicResource PageDescriptionStyle}" />
                </StackPanel>
            </DockPanel>
            <Grid x:Name="DisplayGrid" SizeChanged="OnDisplaySizeChanged">
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Border x:Name="DeviceCard" Margin="0,0,24,0">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource PanelStyle}">
                            <Style.Triggers><DataTrigger Binding="{Binding Snapshot.DeviceKey}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="当前设备" Style="{DynamicResource AuxiliaryTextStyle}" />
                        <TextBlock Text="{Binding DeviceText}" Style="{DynamicResource GroupTitleStyle}" ToolTip="{Binding DeviceText}" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding ResolutionText, StringFormat=分辨率：{0}}" Style="{DynamicResource AuxiliaryTextStyle}" Margin="0,6,0,20" />
                        <Viewbox Stretch="Uniform" MaxHeight="330">
                            <Border Width="576" Height="324" Background="{DynamicResource CanvasBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                                <Grid>
                                    <TextBlock Text="{Binding HostPreviewText}" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380">
                                        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource AuxiliaryTextStyle}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HostPreview}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                    <Image Source="{Binding HostPreview}" Stretch="Uniform" AutomationProperties.Name="主机画面预览" />
                                </Grid>
                            </Border>
                        </Viewbox>
                        <TextBlock Text="主机画面预览" FontWeight="SemiBold" Margin="0,16,0,0" />
                        <TextBlock Text="{Binding HostPreviewText}" Style="{DynamicResource AuxiliaryTextStyle}" Margin="0,4,0,0" />
                        <controls:InlineMessage Message="{Binding HostPreviewErrorText}" Margin="0,8,0,0" />
                        <Button Content="重试预览" Command="{Binding RetryHostPreviewCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource RecoveryButtonStyle}">
                                    <Style.Triggers><DataTrigger Binding="{Binding HostPreviewErrorText}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>
                <Border x:Name="CurrentDisplay" Grid.Column="1">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource PanelStyle}">
                            <Style.Triggers><DataTrigger Binding="{Binding Snapshot.DeviceKey}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="设备控制" Style="{DynamicResource GroupTitleStyle}" Margin="0,0,0,20" />
                        <controls:DeviceStatus Snapshot="{Binding Snapshot}" />
                        <Border Style="{StaticResource DividerStyle}" />
                        <ui:Button Appearance="Primary" Content="编辑主题" Click="OnEditThemeClick" HorizontalAlignment="Stretch" Margin="0,0,0,12" />
                    <WrapPanel>
                        <Button Content="切换到主题模式" Command="{Binding SwitchThemeCommand}" Margin="0,0,8,8">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Snapshot.Mode}" Value="{x:Static sessions:DeviceMode.SecondaryDisplay}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Snapshot.Power}" Value="{x:Static sessions:PowerState.Off}">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="切换到副屏模式" Command="{Binding SwitchScreenCommand}" Margin="0,0,8,8">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Snapshot.Mode}" Value="{x:Static sessions:DeviceMode.Theme}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Snapshot.Power}" Value="{x:Static sessions:PowerState.Off}">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="熄屏" Command="{Binding SleepDisplayCommand}" Margin="0,0,8,8">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Snapshot.Power}" Value="{x:Static sessions:PowerState.On}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="唤醒" Command="{Binding WakeDisplayCommand}" Margin="0,0,8,8">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Snapshot.Power}" Value="{x:Static sessions:PowerState.Off}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="暂停播放" Command="{Binding PauseStreamingCommand}" Margin="0,0,8,8">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Snapshot.Streaming}" Value="{x:Static sessions:StreamingState.Running}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="恢复播放" Command="{Binding ResumeStreamingCommand}" Margin="0,0,8,8">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Snapshot.Streaming}" Value="{x:Static sessions:StreamingState.Paused}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </WrapPanel>
                        <TextBlock Text="{Binding StreamingResultText}" Style="{StaticResource OptionalTextStyle}" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding ProtocolText}" Style="{StaticResource OptionalTextStyle}" Margin="0,8,0,0" />
                        <Button Content="取消操作" Command="{Binding CancelProtocolCommand}" Margin="0,8,0,0" HorizontalAlignment="Left"
                                Visibility="{Binding IsProtocolBusy, Converter={StaticResource BooleanVisibility}}" />
                        <Border Style="{StaticResource DividerStyle}" Margin="0,16" />
                        <Button Content="{Binding DisconnectActionText}" Command="{Binding DisconnectCommand}" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
                <Border Grid.ColumnSpan="2" Padding="0">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource PanelStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers><DataTrigger Binding="{Binding Snapshot.DeviceKey}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <Grid Margin="24">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Width="52" Height="52" CornerRadius="8" Background="{DynamicResource SurfaceRaisedBrush}" VerticalAlignment="Top" HorizontalAlignment="Left">
                                <ui:SymbolIcon Symbol="Desktop24" FontSize="28" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="连接你的 USB 显示设备" FontSize="22" FontWeight="SemiBold" />
                                <TextBlock Text="接入设备后，即可查看画面、切换显示模式与控制播放。" Style="{DynamicResource AuxiliaryTextStyle}" Margin="0,8,0,0" />
                                <WrapPanel Margin="0,20,0,0">
                                    <ui:Button Appearance="Primary" Content="先预览主题" Click="OnEditThemeClick" HorizontalAlignment="Left" Margin="0,0,12,0" />
                                    <TextBlock Text="无需连接，也可以开始设计画面" Style="{DynamicResource AuxiliaryTextStyle}" VerticalAlignment="Center" Margin="0,6" />
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,14">
                            <WrapPanel>
                                <TextBlock Margin="0,4,24,4"><Run Text="01" Foreground="{DynamicResource TextSecondaryBrush}" /><Run Text="  通过 USB 接入" /></TextBlock>
                                <TextBlock Margin="0,4,24,4"><Run Text="02" Foreground="{DynamicResource TextSecondaryBrush}" /><Run Text="  选择并连接设备" /></TextBlock>
                                <TextBlock Margin="0,4,0,4"><Run Text="03" Foreground="{DynamicResource TextSecondaryBrush}" /><Run Text="  应用你的主题" /></TextBlock>
                            </WrapPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
            <controls:InlineMessage Message="{Binding StreamingErrorText}" Margin="0,12,0,0" />
            <controls:InlineMessage Message="{Binding ProtocolErrorText}" Margin="0,12,0,0" />
            <controls:InlineMessage Message="{Binding DeviceErrorText}" Margin="0,12,0,0" />
            <controls:InlineMessage Message="{Binding SubscriptionErrorText}" Margin="0,12,0,0" />
            <Border Style="{StaticResource PanelStyle}" Margin="0,20,0,0">
                <StackPanel>
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Style="{StaticResource StatusBadgeStyle}" Margin="12,0,0,0">
                            <TextBlock Text="{Binding DiscoveryStatusText}" Style="{DynamicResource AuxiliaryTextStyle}" />
                        </Border>
                        <TextBlock Text="可用设备" Style="{DynamicResource GroupTitleStyle}" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="通过 USB 接入设备，然后在列表中选择连接。" Style="{DynamicResource AuxiliaryTextStyle}" Margin="0,8,0,0" />
                    <controls:InlineMessage Message="{Binding DiscoveryErrorText}" Margin="0,12,0,0" />
                    <Border Background="{DynamicResource CanvasBrush}" CornerRadius="6" Padding="16" Margin="0,16,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers><DataTrigger Binding="{Binding DiscoveredDevices.Length}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="设备未出现？请确认设备已供电，并使用支持数据传输的 USB 线缆，再点击右上方的「重新检测」。" Style="{DynamicResource AuxiliaryTextStyle}" />
                    </Border>
                    <StackPanel>
                        <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding DiscoveredDevices.Length}" Value="0"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                        <ListBox ItemsSource="{Binding DiscoveredDevices}" SelectedItem="{Binding SelectedCandidate}" MaxHeight="300"
                                 HorizontalContentAlignment="Stretch" Margin="0,16,0,0" Background="Transparent" BorderThickness="0" AutomationProperties.Name="可用设备">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="8,12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <ui:SymbolIcon Symbol="Desktop24" FontSize="24" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,2,0,0" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" ToolTip="{Binding Title}" />
                                            <TextBlock Text="{Binding InterfacesText}" Style="{DynamicResource AuxiliaryTextStyle}" Margin="0,6,0,0" />
                                            <controls:InlineMessage Message="{Binding ErrorText}" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <WrapPanel Margin="0,16,0,0">
                            <Button Content="选择设备" Command="{Binding ConfirmSelectionCommand}" Margin="0,0,8,0" />
                            <ui:Button Content="连接设备" Command="{Binding ConnectProtocolCommand}" Appearance="Primary" />
                        </WrapPanel>
                        <TextBlock Text="{Binding SelectionText}" Style="{StaticResource OptionalTextStyle}" Margin="0,12,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Expander Header="连接详情" Style="{StaticResource DetailExpanderStyle}" Margin="-8,16,-8,0">
                <StackPanel Margin="8,12">
                    <TextBlock Text="{Binding FirmwareText, StringFormat=固件：{0}}" Style="{DynamicResource AuxiliaryTextStyle}" />
                    <TextBlock Text="{Binding LifecycleText}" Style="{StaticResource OptionalTextStyle}" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding OperationText}" Style="{StaticResource OptionalTextStyle}" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding DisconnectText}" Style="{StaticResource OptionalTextStyle}" Margin="0,8,0,0" />
                </StackPanel>
            </Expander>
            <controls:InlineMessage Message="{Binding LifecycleErrorText}" Margin="0,12,0,0" />
            <controls:InlineMessage Message="{Binding DisconnectErrorText}" Margin="0,12,0,0" />
            <TextBlock Text="{Binding PendingSaveText}" Style="{StaticResource OptionalTextStyle}" Margin="0,8,0,0" />
            <controls:InlineMessage Message="{Binding PendingSaveErrorText}" Margin="0,12,0,0" />
            <TextBlock Text="{Binding LocalSaveResultText}" Style="{StaticResource OptionalTextStyle}" Margin="0,8,0,0" />
            <controls:InlineMessage Message="{Binding LocalSaveErrorText}" Margin="0,12,0,0" />
            <WrapPanel>
                <Button Content="重试保存配置" Command="{Binding RetryPendingSaveCommand}" Style="{StaticResource RecoveryButtonStyle}" />
                <Button Content="重试保存设置" Command="{Binding RetryProtocolSaveCommand}" Style="{StaticResource RecoveryButtonStyle}" />
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
