<Page x:Class="UsbDisplayHost.Desktop.Views.ThemesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:UsbDisplayHost.Desktop.Controls"
      Title="主题" ScrollViewer.CanContentScroll="False">
    <Page.Resources>
        <Style x:Key="ColorValueStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="116" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="MaxLength" Value="7" />
            <Setter Property="ToolTip" Value="输入十六进制颜色，例如 #FFFFFF" />
        </Style>
    </Page.Resources>
    <Grid Margin="{DynamicResource PageContentMargin}" MaxWidth="1120">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <ScrollViewer x:Name="EditorViewport" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" SizeChanged="OnEditorViewportSizeChanged">
            <StackPanel Margin="0,0,12,0">
                <StackPanel x:Name="PageHeader" Margin="0,0,0,20">
                    <TextBlock Text="主题" Style="{DynamicResource PageTitleStyle}" />
                </StackPanel>
                <ListBox x:Name="TemplateSelector" ItemsSource="{Binding Templates}" SelectedValuePath="Value" SelectedValue="{Binding SelectedTemplate, Mode=TwoWay}" SelectionMode="Single"
                         IsEnabled="{Binding CanEdit}" Background="Transparent" BorderThickness="0" Padding="0" IsTabStop="False"
                         AutomationProperties.Name="显示内容" Margin="-4,0,-4,24" HorizontalAlignment="Left">
                    <ListBox.Template><ControlTemplate TargetType="ListBox"><ItemsPresenter /></ControlTemplate></ListBox.Template>
                    <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                            <Setter Property="FocusVisualStyle" Value="{DynamicResource ProjectFocusVisualStyle}" />
                            <Setter Property="MinWidth" Value="96" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Tile" Background="Transparent" CornerRadius="6" Padding="16,10" Margin="4,0">
                                            <Grid>
                                                <TextBlock Text="{Binding Name}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Border x:Name="Mark" Width="18" Height="2" Background="{DynamicResource AccentBrush}" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,-10" Visibility="Hidden" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" /></Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Tile" Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
                                                <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55" /></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
                <Grid x:Name="ContentGrid" SizeChanged="OnContentSizeChanged">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="320" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel x:Name="PreviewPanel" Margin="0,0,24,0">
                        <Border Background="{DynamicResource NavigationBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                            <Viewbox x:Name="PreviewViewport" Stretch="Uniform" MaxHeight="360">
                                <Border Width="640" Height="360" Background="{DynamicResource CanvasBrush}" ClipToBounds="True">
                                    <Image Source="{Binding PreviewImage}" Stretch="Uniform" AutomationProperties.Name="主题画面预览" />
                                </Border>
                            </Viewbox>
                        </Border>
                        <TextBlock Text="本地预览 · 应用后发送到设备" Style="{DynamicResource AuxiliaryTextStyle}" Margin="0,12,0,0" />
                        <controls:InlineMessage Message="{Binding PreviewErrorText}" Margin="0,12,0,0" />
                        <Button Content="重试预览" Command="{Binding RetryPreviewCommand}" HorizontalAlignment="Left" Margin="0,8,0,0">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding PreviewErrorText}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Button.Style>
                        </Button>
                    </StackPanel>
                    <Border x:Name="FieldsPanel" Grid.Column="1" Style="{StaticResource SectionStyle}" VerticalAlignment="Top">
                        <StackPanel IsEnabled="{Binding CanEdit}">
                            <StackPanel Visibility="{Binding IsImage, Converter={StaticResource BooleanVisibility}}">
                                <Button Content="选择图片…" Command="{Binding SelectImageCommand}" HorizontalAlignment="Stretch" AutomationProperties.Name="选择图片" ToolTip="支持 PNG、JPEG 图片" />
                                <TextBlock Text="{Binding ImageDescription}" Style="{DynamicResource AuxiliaryTextStyle}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding ImageDescription}" />
                                <TextBlock Text="图片适配" Margin="0,16,0,8" />
                                <ComboBox ItemsSource="{Binding Fits}" DisplayMemberPath="Name" SelectedValuePath="Value"
                                          SelectedValue="{Binding Fit, Mode=TwoWay}" AutomationProperties.Name="图片适配方式" />
                            </StackPanel>
                            <StackPanel Visibility="{Binding IsClock, Converter={StaticResource BooleanVisibility}}">
                                <CheckBox Content="24 小时制" IsChecked="{Binding Use24HourClock}" />
                                <CheckBox Content="显示日期" IsChecked="{Binding ShowDate}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Visibility="{Binding IsDashboard, Converter={StaticResource BooleanVisibility}}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <CheckBox Content="CPU 使用率" IsChecked="{Binding ShowCpuUsage}" Margin="0,0,8,0" />
                                    <CheckBox Grid.Column="1" Content="内存占用" IsChecked="{Binding ShowMemoryUsage}" />
                                    <CheckBox Grid.Row="1" Content="主机温度" IsChecked="{Binding ShowHostTemperature}" Margin="0,4,8,0" />
                                    <CheckBox Grid.Row="1" Grid.Column="1" Content="设备温度" IsChecked="{Binding ShowDeviceTemperature}" Margin="0,4,0,0" />
                                </Grid>
                            </StackPanel>
                            <DockPanel Margin="0,24,0,0">
                                <TextBox DockPanel.Dock="Right" Style="{StaticResource ColorValueStyle}" Text="{Binding BackgroundColor, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="背景色，十六进制 RGB" />
                                <TextBlock Text="背景色" VerticalAlignment="Center" />
                            </DockPanel>
                            <controls:ColorPalette SelectedColor="{Binding BackgroundColor}" Label="背景色色板" Margin="0,8,0,0" />
                            <StackPanel Margin="0,16,0,0">
                                <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding IsImage}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                <DockPanel>
                                    <TextBox DockPanel.Dock="Right" Style="{StaticResource ColorValueStyle}" Text="{Binding ForegroundColor, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="文字色，十六进制 RGB" />
                                    <TextBlock Text="文字色" VerticalAlignment="Center" />
                                </DockPanel>
                                <controls:ColorPalette SelectedColor="{Binding ForegroundColor}" Label="文字色色板" Margin="0,8,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
                <controls:InlineMessage Message="{Binding ValidationText}" Margin="0,12,0,0" />
                <controls:InlineMessage Message="{Binding ErrorText}" Margin="0,12,0,0" />
                <TextBlock Text="{Binding ApplicationText}" Style="{StaticResource OptionalTextStyle}" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite" />
                <Button Content="取消导入" Command="{Binding SelectImageCancelCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"
                        Visibility="{Binding SelectImageCommand.IsRunning, Converter={StaticResource BooleanVisibility}}" />
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" Style="{StaticResource ActionBarStyle}">
            <Grid x:Name="ActionBar" SizeChanged="OnActionBarSizeChanged">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock x:Name="ActionStatus" Text="{Binding EditorStatus}" Style="{DynamicResource AuxiliaryTextStyle}" VerticalAlignment="Center" Margin="0,0,16,0" />
                <WrapPanel x:Name="PrimaryActions" Grid.Column="1" HorizontalAlignment="Right">
                    <Button Content="恢复默认" Command="{Binding RestoreDefaultsCommand}" Margin="0,0,8,0" />
                    <Button Content="撤销" Command="{Binding UndoCommand}" Margin="0,0,8,0" />
                    <ui:Button Appearance="Primary" Content="{Binding ApplyLabel}" Command="{Binding ApplyCommand}" MinWidth="128" />
                </WrapPanel>
                <WrapPanel Grid.Row="2" Grid.ColumnSpan="2" HorizontalAlignment="Right">
                    <Button Content="重试保存配置" Command="{Binding RetryApplicationSaveCommand}" Margin="8,8,0,0"
                            Visibility="{Binding HasApplicationSave, Converter={StaticResource BooleanVisibility}}" />
                    <Button Content="取消应用" Command="{Binding ApplyCancelCommand}" Margin="8,8,0,0"
                            Visibility="{Binding IsApplying, Converter={StaticResource BooleanVisibility}}" />
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
