<Page x:Class="UsbDisplayHost.Desktop.Views.ApplicationSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:UsbDisplayHost.Desktop.Controls"
      Title="应用设置" ScrollViewer.CanContentScroll="False">
    <Page.Resources>
        <ResourceDictionary Source="/UsbDisplayHost.Desktop;component/Resources/DeviceSettingsResources.xaml" />
    </Page.Resources>
    <Grid Margin="{DynamicResource PageContentMargin}" MaxWidth="1120" UseLayoutRounding="True">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,16,0">
                <TextBlock Text="应用设置" Style="{DynamicResource PageTitleStyle}" Margin="0,0,0,24" />
                <Grid x:Name="SettingsLayout" SizeChanged="OnSettingsLayoutSizeChanged">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Border x:Name="WindowSettings" Style="{StaticResource SectionStyle}" Margin="0,0,32,0" VerticalAlignment="Top" IsEnabled="{Binding CanEdit}">
                        <StackPanel>
                            <TextBlock Text="窗口与启动" Style="{DynamicResource GroupTitleStyle}" Margin="0,0,0,16" />
                            <TextBlock Text="导航布局" Margin="0,0,0,12" />
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <RadioButton Content="顶部导航" IsChecked="{Binding IsTopNavigation, Mode=TwoWay}" GroupName="NavigationLayout" Style="{StaticResource SettingsLayoutOptionStyle}" Margin="0,0,8,0" AutomationProperties.Name="顶部导航" />
                                <RadioButton Grid.Column="1" Content="侧边导航" IsChecked="{Binding IsSideNavigation, Mode=TwoWay}" GroupName="NavigationLayout" Style="{StaticResource SettingsLayoutOptionStyle}" AutomationProperties.Name="侧边导航" />
                            </Grid>
                            <DockPanel Margin="0,0,0,20">
                                <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding CloseBehaviors}" DisplayMemberPath="Label" SelectedValuePath="CloseToTray"
                                          SelectedValue="{Binding CloseToTray, Mode=TwoWay}" Width="160" Margin="16,0,0,0" AutomationProperties.Name="关闭窗口行为" />
                                <TextBlock Text="关闭主窗口时" VerticalAlignment="Center" />
                            </DockPanel>
                            <DockPanel>
                                <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding StartWithWindows}" OnContent="" OffContent="" VerticalAlignment="Center" Margin="16,0,0,0" AutomationProperties.Name="开机自动启动" />
                                <StackPanel>
                                    <TextBlock Text="开机自动启动" />
                                    <TextBlock Text="{Binding StartupStateText}" Style="{DynamicResource AuxiliaryTextStyle}" Margin="0,4,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                    <StackPanel x:Name="AdditionalSettings" Grid.Column="1">
                        <Border Style="{StaticResource SectionStyle}" IsEnabled="{Binding CanEdit}">
                            <StackPanel>
                                <TextBlock Text="设备模式" Style="{DynamicResource GroupTitleStyle}" Margin="0,0,0,16" />
                                <DockPanel Margin="0,0,0,20">
                                    <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding SwitchToThemeOnStartup}" IsEnabled="{Binding CanRevokeStartupMode}"
                                                     OnContent="" OffContent="" Margin="16,0,0,0" AutomationProperties.Name="启动时切换到主题模式" />
                                    <TextBlock Text="启动时切换到主题模式" VerticalAlignment="Center" />
                                </DockPanel>
                                <DockPanel>
                                    <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding SwitchToSecondaryOnExit}" IsEnabled="{Binding CanRevokeExitMode}"
                                                     OnContent="" OffContent="" Margin="16,0,0,0" AutomationProperties.Name="退出时切回副屏模式" />
                                    <TextBlock Text="退出时切回副屏模式" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Text="连接支持模式切换的设备后可启用" Margin="0,12,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource AuxiliaryTextStyle}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding CanEdit}" Value="True" />
                                                        <Condition Binding="{Binding CanRevokeStartupMode}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding CanEdit}" Value="True" />
                                                        <Condition Binding="{Binding CanRevokeExitMode}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SectionStyle}" Margin="0,32,0,0">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,16">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Updates.CurrentVersion, StringFormat=版本 {0}}" Style="{DynamicResource AuxiliaryTextStyle}" VerticalAlignment="Center" />
                                    <TextBlock Text="软件更新" Style="{DynamicResource GroupTitleStyle}" />
                                </DockPanel>
                                <DockPanel Margin="0,0,0,20">
                                    <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding AutomaticallyCheckUpdates}" IsEnabled="{Binding CanEdit}"
                                                     OnContent="" OffContent="" Margin="16,0,0,0" AutomationProperties.Name="自动检查更新" />
                                    <TextBlock Text="自动检查更新" VerticalAlignment="Center" />
                                </DockPanel>
                                <StackPanel DataContext="{Binding Updates}">
                                    <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Style="{DynamicResource AuxiliaryTextStyle}" />
                                    <ProgressBar Value="{Binding Progress}" IsIndeterminate="{Binding IsIndeterminate}" Height="6" Margin="0,12,0,0" AutomationProperties.Name="更新下载进度">
                                        <ProgressBar.Style><Style TargetType="ProgressBar"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsProgressVisible}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></ProgressBar.Style>
                                    </ProgressBar>
                                    <controls:InlineMessage Message="{Binding ErrorText}" Margin="0,8,0,0" />
                                    <WrapPanel Margin="0,12,0,0">
                                        <Button Content="{Binding ActionText}" Command="{Binding ActCommand}" Margin="0,0,8,8" />
                                        <Button Content="取消" Command="{Binding ActCancelCommand}" Margin="0,0,8,8">
                                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding CanCancel}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Button.Style>
                                        </Button>
                                        <Button Content="GitHub 下载页" Command="{Binding OpenReleasesCommand}" Margin="0,0,0,8" />
                                    </WrapPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
                <controls:InlineMessage Message="{Binding ErrorText}" Margin="0,16,0,0" />
                <Button Content="重新读取设置" Command="{Binding ReloadCommand}" HorizontalAlignment="Left" Margin="0,8,0,0">
                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding ErrorText}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Button.Style>
                </Button>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" Style="{StaticResource ActionBarStyle}">
            <Grid x:Name="ActionBar" SizeChanged="OnActionBarSizeChanged">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock x:Name="ActionStatus" AutomationProperties.LiveSetting="Polite" Text="{Binding StatusText}" Style="{DynamicResource AuxiliaryTextStyle}" VerticalAlignment="Center" Margin="0,0,16,0" />
                <StackPanel x:Name="PrimaryActions" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="撤销更改" Command="{Binding DiscardEditsCommand}" Margin="0,0,8,0" />
                    <ui:Button Appearance="Primary" Content="保存设置" Command="{Binding SaveCommand}" MinWidth="120" />
                </StackPanel>
                <WrapPanel Grid.Row="2" Grid.ColumnSpan="2" HorizontalAlignment="Right">
                    <Button Content="取消保存" Command="{Binding SaveCancelCommand}" Margin="8,8,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BooleanVisibility}}" />
                    <Button Content="核实保存" Command="{Binding VerifySaveCommand}" Margin="8,8,0,0" Visibility="{Binding HasUnconfirmedSave, Converter={StaticResource BooleanVisibility}}" />
                </WrapPanel>
                <ProgressBar Grid.Row="3" Grid.ColumnSpan="2" IsIndeterminate="True" Height="3" Margin="0,8,0,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanVisibility}}" AutomationProperties.Name="应用设置处理进度" />
            </Grid>
        </Border>
    </Grid>
</Page>
