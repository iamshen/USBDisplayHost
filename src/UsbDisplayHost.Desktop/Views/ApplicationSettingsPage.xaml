<Page x:Class="UsbDisplayHost.Desktop.Views.ApplicationSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:UsbDisplayHost.Desktop.Controls"
      Title="应用设置" ScrollViewer.CanContentScroll="False">
    <Page.Resources>
        <Style x:Key="LayoutOptionStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource ProjectFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Tile" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource CanvasBrush}" CornerRadius="5" Padding="12,8" Margin="4,0,0,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Tile" Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
                                <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>
    <Grid Margin="{DynamicResource PageContentMargin}" MaxWidth="1120">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,16,0">
                <TextBlock Text="应用设置" Style="{DynamicResource PageTitleStyle}" Margin="0,0,0,24" />
                <Border Style="{StaticResource PanelStyle}" Padding="20" IsEnabled="{Binding CanEdit}">
                    <StackPanel>
                        <TextBlock Text="窗口与启动" Style="{DynamicResource GroupTitleStyle}" Margin="0,0,0,16" />
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="16,0,0,0">
                                <RadioButton Content="顶部导航" IsChecked="{Binding IsTopNavigation, Mode=TwoWay}" GroupName="NavigationLayout" Style="{StaticResource LayoutOptionStyle}" AutomationProperties.Name="顶部导航" />
                                <RadioButton Content="侧边导航" IsChecked="{Binding IsSideNavigation, Mode=TwoWay}" GroupName="NavigationLayout" Style="{StaticResource LayoutOptionStyle}" AutomationProperties.Name="侧边导航" />
                            </StackPanel>
                            <TextBlock Text="导航布局" VerticalAlignment="Center" />
                        </DockPanel>
                        <Border Style="{StaticResource DividerStyle}" Margin="0,12" />
                        <DockPanel>
                            <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding CloseBehaviors}" DisplayMemberPath="Label" SelectedValuePath="CloseToTray"
                                      SelectedValue="{Binding CloseToTray, Mode=TwoWay}" Width="180" Margin="16,0,0,0" AutomationProperties.Name="关闭窗口行为" />
                            <TextBlock Text="关闭主窗口时" VerticalAlignment="Center" />
                        </DockPanel>
                        <Border Style="{StaticResource DividerStyle}" Margin="0,12" />
                        <DockPanel>
                            <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding StartWithWindows}" OnContent="" OffContent="" VerticalAlignment="Center" Margin="16,0,0,0" AutomationProperties.Name="开机自动启动" />
                            <StackPanel>
                                <TextBlock Text="开机自动启动" />
                                <TextBlock Text="{Binding StartupStateText}" Style="{DynamicResource AuxiliaryTextStyle}" Margin="0,4,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource PanelStyle}" Padding="20" Margin="0,16,0,0" IsEnabled="{Binding CanEdit}">
                    <StackPanel>
                        <TextBlock Text="设备模式" Style="{DynamicResource GroupTitleStyle}" Margin="0,0,0,16" />
                        <DockPanel>
                            <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding SwitchToThemeOnStartup}" IsEnabled="{Binding CanRevokeStartupMode}"
                                             OnContent="" OffContent="" Margin="16,0,0,0" AutomationProperties.Name="启动时切换到主题模式" />
                            <TextBlock Text="启动时切换到主题模式" VerticalAlignment="Center" />
                        </DockPanel>
                        <Border Style="{StaticResource DividerStyle}" Margin="0,12" />
                        <DockPanel>
                            <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding SwitchToSecondaryOnExit}" IsEnabled="{Binding CanRevokeExitMode}"
                                             OnContent="" OffContent="" Margin="16,0,0,0" AutomationProperties.Name="退出时切回副屏模式" />
                            <TextBlock Text="退出时切回副屏模式" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="连接支持模式切换的设备后可启用" Style="{DynamicResource AuxiliaryTextStyle}" Margin="0,16,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource PanelStyle}" Padding="20" Margin="0,16,0,0">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,16">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding CurrentVersion, StringFormat=版本 {0}}" Style="{DynamicResource AuxiliaryTextStyle}" VerticalAlignment="Center" />
                            <TextBlock Text="软件更新" Style="{DynamicResource GroupTitleStyle}" />
                        </DockPanel>
                        <DockPanel>
                            <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding AutomaticallyCheckUpdates}" IsEnabled="{Binding CanEdit}"
                                             OnContent="" OffContent="" Margin="16,0,0,0" AutomationProperties.Name="自动检查更新" />
                            <TextBlock Text="自动检查更新" VerticalAlignment="Center" />
                        </DockPanel>
                        <Border Style="{StaticResource DividerStyle}" Margin="0,12" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="检查更新" IsEnabled="False" Margin="16,0,0,0" />
                            <TextBlock Text="更新服务暂未接入" Style="{DynamicResource AuxiliaryTextStyle}" VerticalAlignment="Center" />
                        </DockPanel>
                    </StackPanel>
                </Border>
                <controls:InlineMessage Message="{Binding ErrorText}" Margin="0,16,0,0" />
                <Button Content="重新读取设置" Command="{Binding ReloadCommand}" HorizontalAlignment="Left" Margin="0,8,0,0">
                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding ErrorText}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Button.Style>
                </Button>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" Style="{StaticResource ActionBarStyle}">
            <Grid x:Name="ActionBar" SizeChanged="OnActionBarSizeChanged">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock x:Name="ActionStatus" Text="{Binding StatusText}" Style="{DynamicResource AuxiliaryTextStyle}" VerticalAlignment="Center" Margin="0,0,16,0" />
                <StackPanel x:Name="PrimaryActions" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="撤销更改" Command="{Binding DiscardEditsCommand}" Margin="0,0,8,0" />
                    <ui:Button Appearance="Primary" Content="保存设置" Command="{Binding SaveCommand}" MinWidth="120" />
                </StackPanel>
                <WrapPanel Grid.Row="2" Grid.ColumnSpan="2" HorizontalAlignment="Right">
                    <Button Content="取消保存" Command="{Binding SaveCancelCommand}" Margin="8,8,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BooleanVisibility}}" />
                    <Button Content="核实保存" Command="{Binding VerifySaveCommand}" Margin="8,8,0,0" Visibility="{Binding HasUnconfirmedSave, Converter={StaticResource BooleanVisibility}}" />
                </WrapPanel>
                <ProgressBar Grid.Row="3" Grid.ColumnSpan="2" IsIndeterminate="True" Height="3" Margin="0,8,0,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanVisibility}}" AutomationProperties.Name="应用设置处理进度" />
            </Grid>
        </Border>
    </Grid>
</Page>
