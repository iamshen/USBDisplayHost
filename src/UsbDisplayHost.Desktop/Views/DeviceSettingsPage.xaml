<Page x:Class="UsbDisplayHost.Desktop.Views.DeviceSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:UsbDisplayHost.Desktop.Controls"
      xmlns:configuration="clr-namespace:UsbDisplayHost.Core.Configuration;assembly=UsbDisplayHost.Core"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="设备设置" Foreground="{DynamicResource TextPrimaryBrush}"
      Background="{DynamicResource CanvasBrush}" ScrollViewer.CanContentScroll="False">
    <Page.Resources>
        <ResourceDictionary Source="/UsbDisplayHost.Desktop;component/Resources/DeviceSettingsResources.xaml" />
    </Page.Resources>
    <Grid Margin="{DynamicResource PageContentMargin}" MaxWidth="1120" UseLayoutRounding="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,16,0">
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="设备设置" Style="{DynamicResource PageTitleStyle}" />
                    <Border Grid.Column="1" Style="{StaticResource SettingsBadgeStyle}" Margin="16,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" />
                            <TextBlock Style="{StaticResource SettingsCaptionStyle}" MaxWidth="240" TextTrimming="CharacterEllipsis"
                                       Text="{Binding DeviceText}" TextWrapping="NoWrap" />
                        </StackPanel>
                    </Border>
                </Grid>
                <Border Style="{StaticResource SettingsSectionStyle}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,24">
                            <TextBlock DockPanel.Dock="Right" Text="应用后生效" Style="{StaticResource SettingsCaptionStyle}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                            <TextBlock Text="图像输出" Style="{DynamicResource GroupTitleStyle}" />
                        </DockPanel>
                        <Grid x:Name="OutputLayout" SizeChanged="OnOutputLayoutSizeChanged">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel x:Name="DirectionSection" Margin="0,0,32,0">
                                <TextBlock Text="显示方向" Margin="0,0,0,12" />
                                <Border Background="{DynamicResource CanvasBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="16,12">
                                    <Grid Height="130">
                                        <Border Width="204" Height="116" BorderThickness="2" CornerRadius="7"
                                                BorderBrush="{DynamicResource TextSecondaryBrush}" Background="{DynamicResource SurfaceRaisedBrush}">
                                            <Grid>
                                                <Grid Width="52" Height="68" RenderTransformOrigin="0.5,0.5">
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Rotation}" Value="{x:Static configuration:DisplayRotation.Degrees90}">
                                                                    <Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="90" /></Setter.Value></Setter>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Rotation}" Value="{x:Static configuration:DisplayRotation.Degrees180}">
                                                                    <Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="180" /></Setter.Value></Setter>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Rotation}" Value="{x:Static configuration:DisplayRotation.Degrees270}">
                                                                    <Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="270" /></Setter.Value></Setter>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <Path Data="M 10,28 L 26,12 42,28 M 26,13 L 26,55"
                                                          Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="3"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                                </Grid>
                                                <Ellipse Width="4" Height="4" Fill="{DynamicResource TextSecondaryBrush}"
                                                         VerticalAlignment="Bottom" Margin="0,0,0,6" />
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="方向示意" Style="{StaticResource SettingsCaptionStyle}" FontSize="10"
                                                   HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                    </Grid>
                                </Border>
                                <ListBox ItemsSource="{Binding Rotations}" SelectedValuePath="Value" IsEnabled="{Binding CanEdit}"
                                         SelectedValue="{Binding Rotation, Mode=TwoWay}" SelectionMode="Single"
                                         IsSynchronizedWithCurrentItem="False" ItemContainerStyle="{StaticResource SettingsRotationItemStyle}"
                                         Margin="-3,12,-3,0" BorderThickness="0" Background="Transparent" Padding="0" IsTabStop="False"
                                         KeyboardNavigation.DirectionalNavigation="Contained" AutomationProperties.Name="显示方向">
                                    <ListBox.Template><ControlTemplate TargetType="ListBox"><ItemsPresenter /></ControlTemplate></ListBox.Template>
                                    <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding Label}" TextAlignment="Center" /></DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                            <StackPanel x:Name="OutputParameters" Grid.Column="1">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="136" /></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="帧率上限" />
                                        <TextBlock Text="每秒发送帧数" Style="{StaticResource SettingsCaptionStyle}" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding FrameRates}" SelectedItem="{Binding FramesPerSecond, Mode=TwoWay}"
                                              IsEnabled="{Binding CanEdit}" MinHeight="40" AutomationProperties.Name="帧率上限，1到5 fps">
                                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat={}{0} fps}" /></DataTemplate></ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                                <Border Style="{StaticResource SettingsDividerStyle}" Margin="0,16,0,24" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="92" /></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="JPEG 画质" />
                                        <TextBlock Text="70–85" Style="{StaticResource SettingsCaptionStyle}" />
                                    </StackPanel>
                                    <ui:NumberBox Grid.Column="1" Value="{Binding JpegQuality, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Minimum="70" Maximum="85" SmallChange="1" IsEnabled="{Binding CanEdit}"
                                                  MinHeight="40" AutomationProperties.Name="JPEG 画质，70到85" />
                                </Grid>
                                <Slider Minimum="70" Maximum="85" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,18,0,0"
                                        Value="{Binding JpegQuality, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}"
                                        AutomationProperties.Name="JPEG 画质滑块，70到85" />
                                <DockPanel Margin="0,6,0,0">
                                    <TextBlock Text="更清晰" DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource SettingsCaptionStyle}" />
                                    <TextBlock Text="更小体积" Style="{StaticResource SettingsCaptionStyle}" />
                                </DockPanel>
                            </StackPanel>
                        </Grid>
                        <controls:InlineMessage Message="{Binding ValidationText}" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SettingsSectionStyle}" Margin="0,16,0,0" DataContext="{Binding DeviceControls}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,16">
                            <TextBlock DockPanel.Dock="Right" Text="即时生效" Style="{StaticResource SettingsCaptionStyle}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="屏幕亮度" Style="{DynamicResource GroupTitleStyle}" />
                                <TextBlock Text="{Binding BrightnessText}" Style="{StaticResource SettingsCaptionStyle}" Margin="16,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>
                        <Grid x:Name="BrightnessLayout" SizeChanged="OnBrightnessLayoutSizeChanged">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid x:Name="BrightnessSliderArea" Margin="0,0,24,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="0" Style="{StaticResource SettingsCaptionStyle}" VerticalAlignment="Center" Margin="0,0,16,0" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                        Value="{Binding BrightnessTarget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        IsEnabled="{Binding CanAdjustBrightness}" AutomationProperties.Name="目标亮度，0到100" />
                                <TextBlock Grid.Column="2" Text="100" Style="{StaticResource SettingsCaptionStyle}" VerticalAlignment="Center" Margin="16,0,0,0" />
                            </Grid>
                            <StackPanel x:Name="BrightnessInput" Grid.Column="1" Orientation="Horizontal">
                                <ui:NumberBox Value="{Binding BrightnessValue, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Minimum="0" Maximum="100"
                                              SmallChange="1" Width="80" IsEnabled="{Binding CanAdjustBrightness}"
                                              AutomationProperties.Name="精确亮度，百分比，0到100" />
                                <Button Content="设置" Command="{Binding ApplyBrightnessCommand}" Margin="8,0,0,0" MinWidth="64" AutomationProperties.Name="设置亮度" />
                            </StackPanel>
                        </Grid>
                        <controls:InlineMessage Message="{Binding ProtocolErrorText}" Margin="0,12,0,0" />
                        <Button Content="重试保存亮度" Command="{Binding RetryProtocolSaveCommand}" Style="{StaticResource SettingsRecoveryButtonStyle}" />
                    </StackPanel>
                </Border>
                <Expander Header="设备信息" Style="{StaticResource SettingsDetailExpanderStyle}" Margin="-8,16,-4,0"
                          Visibility="{Binding IsConnected, Converter={StaticResource BooleanVisibility}}">
                    <WrapPanel DataContext="{Binding DeviceControls}" Margin="8,8">
                        <TextBlock Text="{Binding ResolutionText, StringFormat=分辨率：{0}}" Style="{StaticResource SettingsCaptionStyle}" Margin="0,0,24,8" />
                        <TextBlock Text="{Binding FirmwareText, StringFormat=固件：{0}}" Style="{StaticResource SettingsCaptionStyle}" Margin="0,0,24,8" />
                        <TextBlock Text="{Binding RequestedBrightnessText, StringFormat=已受理亮度：{0}}" Style="{StaticResource SettingsCaptionStyle}" />
                    </WrapPanel>
                </Expander>
                <TextBlock Text="{Binding ApplicationText}" Style="{StaticResource SettingsOptionalTextStyle}" AutomationProperties.LiveSetting="Polite" />
                <controls:InlineMessage Message="{Binding ErrorText}" Margin="0,12,0,0" />
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" Style="{DynamicResource ActionBarStyle}">
            <Grid x:Name="ActionBar" SizeChanged="OnActionBarSizeChanged">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock x:Name="ActionStatus" Text="{Binding StatusText}" Style="{StaticResource SettingsCaptionStyle}" VerticalAlignment="Center"
                           Margin="0,0,16,0" AutomationProperties.LiveSetting="Polite" />
                <StackPanel x:Name="PrimaryActions" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="恢复默认" Command="{Binding RestoreDefaultsCommand}" Margin="0,0,8,0" />
                    <Button Content="撤销" Command="{Binding UndoCommand}" Margin="0,0,8,0" />
                    <ui:Button Content="{Binding ApplyLabel}" Command="{Binding ApplyCommand}" Appearance="Primary" MinWidth="120" />
                </StackPanel>
                <WrapPanel Grid.Row="2" Grid.ColumnSpan="2" HorizontalAlignment="Right">
                    <Button Content="取消应用" Command="{Binding ApplyCancelCommand}" Margin="8,8,0,0"
                            Visibility="{Binding IsApplying, Converter={StaticResource BooleanVisibility}}" />
                    <Button Content="重试保存设置" Command="{Binding RetryApplicationSaveCommand}" Margin="8,8,0,0"
                            Visibility="{Binding HasApplicationSave, Converter={StaticResource BooleanVisibility}}" />
                </WrapPanel>
                <ProgressBar Grid.Row="3" Grid.ColumnSpan="2" IsIndeterminate="True" Height="3" Margin="0,8,0,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanVisibility}}" AutomationProperties.Name="设备设置处理进度" />
            </Grid>
        </Border>
    </Grid>
</Page>
